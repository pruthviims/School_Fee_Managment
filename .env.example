# Postgres connection string. In production, use Neon's *pooled* connection
# string (the one with "-pooler" in the hostname) — see server/db/index.ts
# for why. Local dev: postgres://postgres:postgres@localhost:5432/schoolfee_dev
DATABASE_URL=

# Signs session tokens and password-reset/staff-invite links. Generate with:
#   openssl rand -hex 32
# Required — the server refuses to start real auth flows without it.
JWT_SECRET=

# Where password-reset and staff-invite links point — the React app's own
# origin, not this API. It needs a /reset-password route (see the
# frontend integration work).
FRONTEND_URL=http://localhost:5173

# Email: unset means mail is printed to the server log instead of sent —
# fine for local dev and CI. Set these for real delivery in production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@fee-portal.local

# How long a password-reset / staff-invite link stays valid, in
# milliseconds. Defaults to 24 hours if unset.
PASSWORD_RESET_TIMEOUT_MS=86400000

# Required to create a new school (Platform Setup) at all — without this
# set, POST /auth/bootstrap-school refuses every request outright. This
# is the one unauthenticated door into the whole system, so it's gated
# by a secret only the deployer knows, not left open to anyone who finds
# the URL. Generate with: openssl rand -hex 24
# Give this value to whoever should be allowed to create a school.
ADMIN_SETUP_TOKEN=
